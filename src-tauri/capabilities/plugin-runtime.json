{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "plugin-runtime",
  "description": "Restricted capability for the trusted plugin worker host",
  "windows": ["plugin-runtime"],
  "permissions": [
    "core:default",
    "core:app:allow-set-app-theme",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    "allow-plugin-read-entry",
    "allow-plugin-invoke-api"
  ]
}
