{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for trusted Linyu application windows",
  "windows": [
    "login",
    "tray",
    "messageRemind",
    "screenshot",
    "home",
    "emotion",
    "set",
    "feedback",
    "imgViewer",
    "videoViewer",
    "file-preview-*",
    "chatRecord",
    "addContacts",
    "groupNotice",
    "call",
    "callinvite",
    "chatSession-*",
    "moment-*"
  ],
  "permissions": [
    "core:default",
    "core:app:allow-set-app-theme",
    "core:app:allow-default-window-icon",
    "core:event:allow-listen",
    "core:event:allow-emit-to",
    "core:webview:allow-create-webview-window",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-request-user-attention",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-unmaximize",
    "core:window:allow-unminimize",
    "core:window:allow-set-position",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "http:default",
    "http:allow-fetch",
    "http:allow-fetch-cancel",
    "http:allow-fetch-read-body",
    "http:allow-fetch-send",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://**"
        },
        {
          "url": "https://**"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    "process:default",
    "shell:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-applocaldata-read-recursive",
    "fs:allow-applocaldata-write-recursive",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "dialog:default",
    "notification:default",
    "websocket:default",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-write-image",
    "upload:default",
    "drag:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "allow-capture-screen",
    "allow-start-oauth-server",
    "allow-write-clipboard-files",
    "allow-show-app-notification",
    "allow-upload-file-chunks",
    "allow-upload-space-file-chunks",
    "allow-compute-space-file-hash",
    "allow-cancel-space-file-upload",
    "allow-download-space-file",
    "allow-cancel-space-file-download",
    "allow-plugin-get-system-info",
    "allow-plugin-prepare-remote",
    "allow-plugin-prepare-local",
    "allow-plugin-prepare-development",
    "allow-plugin-export-development",
    "allow-plugin-abort-install",
    "allow-plugin-commit-install",
    "allow-plugin-uninstall",
    "allow-plugin-set-enabled",
    "allow-plugin-read-entry",
    "allow-plugin-invoke-api",
    "allow-work-runtime-list",
    "allow-work-runtime-detect",
    "allow-work-runtime-check-update",
    "allow-work-runtime-install",
    "allow-work-provider-list",
    "allow-work-preferences-get",
    "allow-work-preferences-save",
    "allow-work-provider-save",
    "allow-work-provider-test",
    "allow-work-provider-delete",
    "allow-work-skill-local-state",
    "allow-work-skill-install",
    "allow-work-skill-uninstall",
    "allow-work-skill-set-enabled",
    "allow-work-session-new",
    "allow-work-session-prompt",
    "allow-work-session-cancel",
    "allow-work-session-close",
    "allow-work-session-set-config",
    "allow-work-session-resolve-permission",
    "allow-work-status"
  ]
}
