{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linyu",
  "version": "0.1.0",
  "identifier": "chat.linyu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "登录",
        "url": "/login",
        "label": "login",
        "width": 336,
        "height": 580,
        "fullscreen": false,
        "resizable": false,
        "center": true,
        "skipTaskbar": false,
        "transparent": true,
        "decorations": false,
        "dragDropEnabled": false,
        "visible": false,
        "windowEffects":{
          "effects": ["acrylic"],
          "state": "active"
        },
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      },
      {
        "title": "linyu",
        "label": "tray",
        "url": "/tray",
        "resizable": false,
        "center": false,
        "visible": false,
        "width": 70,
        "height": 40,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      },
      {
        "title": "消息提醒",
        "label": "messageRemind",
        "url": "/messageRemind",
        "resizable": false,
        "center": false,
        "visible": false,
        "width": 240,
        "height": 82,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      },
      {
        "title": "截图",
        "label": "screenshot",
        "url": "/screenshot",
        "resizable": false,
        "center": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "fullscreen": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --use-fake-ui-for-media-stream"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset: data: blob:",
        "script-src": "'self' 'unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http: https: ws: wss:",
        "img-src": "'self' asset: http://asset.localhost http: https: data: blob:",
        "media-src": "'self' asset: http://asset.localhost http: https: data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' data: blob:",
        "object-src": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/**"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "html",
      "resources/file-icons"
    ],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
